            "default": null,
            "title": "Replaced By Identifier"
          }
        },
        "required": [
          "@id",
          "http://www.w3.org/2002/07/owl#deprecated",
          "https://vocab.brightway.one/terms/deprecationReason",
          "identifier"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 7,
      "type": "integer"
    }
  },
  "required": [
    "@context",
    "schema_version",
    "flows",
    "redirects",
    "concept_schemes",
    "correspondences"
  ],
  "title": "harmonised-flows-simple.json.gz",
  "type": "object"
}
