        "$ref": "#/$defs/ArtifactFlow"
      },
      "title": "Flows",
      "type": "array"
    },
    "release": {
      "$ref": "#/$defs/ArtifactRelease"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "unit_processes": {
      "items": {
        "$ref": "#/$defs/UnitProcess"
      },
      "title": "Unit Processes",
      "type": "array"
    }
  },
  "required": [
    "categories",
    "factors",
    "flows",
    "release",
    "schema_version",
    "unit_processes"
