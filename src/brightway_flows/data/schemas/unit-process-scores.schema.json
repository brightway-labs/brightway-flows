    "categories": {
      "items": {
        "$ref": "#/$defs/ArtifactCategory"
      },
      "title": "Categories",
      "type": "array"
    },
    "factors": {
      "items": {
        "$ref": "#/$defs/ArtifactFactor"
      },
      "title": "Factors",
      "type": "array"
    },
    "flows": {
